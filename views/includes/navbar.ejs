<style>
  /* Use a more specific selector to avoid Bootstrap .btn conflicts and remove duplicate rules */
  .btn.search-btn{
    background-color: #ff385c;
    color: #fff;
    border: none;
    padding: 8px 14px;
    border-radius: 25px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 15px;
  }
  .btn.search-btn:hover {
    background-color: #e0324a;
    color: #fff;
  }
  .btn.search-btn i{
    display: inline-block;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  /* // */
  
.search-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    margin: 0 10rem;
}

.search-options {
    display: flex;
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 50px;
    overflow: hidden;
    align-items: center;
} 

.logo {
    width: 120px;
    height: auto;
}

.search-option {
    padding: 10px 20px;
    border-right: 1px solid #ddd;
    text-align: center;
}

.search-option:last-child {
    border-right: none;
}

.search-option label {
    display: block;
    font-size: 12px;
    color: #0c0c0c;
    margin-bottom: 5px;
}

.search-option input {
    border: none;
    outline: none;
    font-size: 14px;
    color: #333;
    background-color: transparent;
}

/* Profile dropdown button */
.profile-button {
  border: 1px solid #ddd;
  padding: 0.5rem 1rem;
  cursor: pointer;
  border-radius: 40px;
  background-color: white;
}

/* Dropdown menu styling */
.dropdown-menu {
  min-width: 150px;
  border: 1px solid #e3e0e0;
}

/* Align icons in the button */
.profile-button i {
  font-size: 1.2rem;
}

/* Navbar padding and design */
.navbar {
  padding: 1rem;
  background-color: white;
  border-bottom: 1px solid #ddd;
}

/* Profile icon and button hover effects */
.profile-button:hover {
  background-color: #f3f3f3;
}

/* Dropdown items styling */
.dropdown-item {
  font-size: 16px;
  padding: 0.5rem 1rem;
}

.dropdown-item:hover {
  background-color: #f3f3f3;
}


</style>
<nav class="navbar navbar-expand-md bg-body-Light border-bottom sticky-top">
  <div class="container-fluid">

    
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" 
    type="button"
     data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup" 
      >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
     <h3> Wanderlust</h3>
        
        <div class="navbar-nav ms-auto"> 
         <form class="d-flex" role="search" action="/listings/search" method="GET">
  <input
    class="form-control me-2 search-inp"
    type="search"
    name="q"
    placeholder="Search Destinations"
    aria-label="Search"
  />
  <button class="btn search-btn" type="submit">
    <i class="fa-solid fa-magnifying-glass"></i> Search
  </button>
</form>

          
         
        </div>
       

        <div class="navbar-nav ms-auto">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
        
          <!-- Dropdown Menu for Sign up/Login or Logout -->
          <div class="dropdown">
            <button class="btn btn-light rounded-pill d-flex align-items-center profile-button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-globe me-2"></i>
              <i class="fas fa-bars"></i>
              <i class="fas fa-user-circle ms-2"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
              <% if (!CurrUser) { %>
                <li><a class="dropdown-item" href="/signup">Sign Up</a></li>
                <li><a class="dropdown-item" href="/login">Log In</a></li>
              <% } %>
              <% if (CurrUser) { %>
                <li><a class="dropdown-item" href="/logout">Log Out</a></li>
              <% } %>
            </ul>
          </div>
        </div>
    </div>
  </div>
  </nav>